#: includes/class-eg-repo-card-admin.php:236
msgid "Border"
msgstr "Bordo"

#: includes/class-eg-repo-card-admin.php:236
msgid "Show a border around the card"
msgstr "Mostra un bordo intorno alla card"

#: includes/class-eg-repo-card-admin.php:237
msgid "Shadow"
msgstr "Ombra"

#: includes/class-eg-repo-card-admin.php:237
msgid "Show a shadow under the card"
