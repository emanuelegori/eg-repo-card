msgstr "Questo repository è in sola lettura"

#: includes/class-eg-repo-card-shortcode.php:142
msgid "Archived"
msgstr "Archiviato"

#: includes/class-eg-repo-card-shortcode.php:158
msgid "Project website"
msgstr "Sito web del progetto"

#: includes/class-eg-repo-card-shortcode.php:160
msgid "Website"
msgstr "Sito web"

#: includes/class-eg-repo-card-shortcode.php:165
