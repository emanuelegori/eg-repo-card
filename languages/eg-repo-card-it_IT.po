msgid "Show the owner avatar or the plugin icon"
msgstr "Mostra l'avatar del proprietario o l'icona del plugin"

#: includes/class-eg-repo-card-admin.php:242
msgid "The image is loaded from the platform that hosts it."
msgstr "L'immagine arriva direttamente dalla piattaforma che la ospita."

#: includes/class-eg-repo-card-admin.php:276
msgid "Transparent"
msgstr "Trasparente"

#: includes/class-eg-repo-card-admin.php:277
msgid "Follow the visitor browser"
msgstr "Segue il browser del visitatore"

#: includes/class-eg-repo-card-admin.php:278
#: includes/class-eg-repo-card-admin.php:296
msgid "Custom color"
msgstr "Colore personalizzato"

#: includes/class-eg-repo-card-admin.php:300
msgid "\"Follow the visitor browser\" switches between light and dark with the system theme. The color picker applies only to \"Custom color\"."
msgstr "\"Segue il browser del visitatore\" alterna chiaro e scuro seguendo il tema del sistema. Il selettore di colore vale solo per \"Colore personalizzato\"."

# translators: %s: platform name (GitHub or Forgejo)
#. translators: %s: platform name (GitHub or Forgejo / Gitea)
