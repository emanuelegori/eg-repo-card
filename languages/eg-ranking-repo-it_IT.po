msgid "Settings"
msgstr "Impostazioni"

msgid "Documentation"
msgstr "Documentazione"

msgid "API Tokens"
msgstr "Token API"

msgid "Optional tokens to increase API rate limits."
msgstr "Token opzionali per aumentare il rate limit delle chiamate API."

msgid "Without token: 60 requests/hour. With token: 5,000 requests/hour."
msgstr "Senza token: 60 richieste/ora. Con token: 5.000 richieste/ora."

msgid "Forgejo API Token (optional)"
msgstr "Forgejo API Token (opzionale)"

msgid "Required only for private repositories or instances with mandatory authentication."
msgstr "Necessario solo per repository privati o istanze con autenticazione obbligatoria."

msgid "Cache"
msgstr "Cache"

msgid "Repository data is cached to reduce API calls."
msgstr "I dati dei repository vengono messi in cache per ridurre le chiamate API."

msgid "Cache duration (hours)"
msgstr "Durata cache (ore)"

msgid "Recommended values: 6–24 hours. Maximum 168 (1 week)."
msgstr "Valori consigliati: 6–24 ore. Massimo 168 (1 settimana)."

msgid "Card style"
msgstr "Stile card"

msgid "Customise the card colours. The default values ensure maximum readability."
msgstr "Personalizza i colori della card. I valori predefiniti garantiscono la massima leggibilità."

msgid "Card background colour"
msgstr "Colore sfondo card"

msgid "Card text colour"
msgstr "Colore testo card"

msgid "Button background colour"
msgstr "Colore sfondo bottoni"

msgid "Button text colour"
msgstr "Colore testo bottoni"

# translators: %s: platform name (GitHub or Forgejo)
msgid "Token %s removed."
msgstr "Token %s rimosso."

msgid "Cache cleared."
msgstr "Cache svuotata."

msgid "EG Ranking Repo — Settings"
msgstr "EG Ranking Repo — Impostazioni"

msgid "Save settings"
msgstr "Salva impostazioni"

msgid "Flush cache"
msgstr "Svuota cache"

msgid "Forces a fresh data fetch from repositories on next page view."
msgstr "Forza il recupero aggiornato dei dati dai repository alla prossima visualizzazione."

msgid "Flush cache now"
msgstr "Svuota cache ora"

msgid "Remove API tokens"
msgstr "Rimuovi token API"

msgid "Use these buttons to delete a saved token (e.g. if it has been compromised)."
msgstr "Usa questi pulsanti per eliminare un token salvato (ad esempio se è stato compromesso)."

# translators: %s: platform name (GitHub or Forgejo)
msgid "Remove %s token"
msgstr "Rimuovi token %s"

msgid "No token saved."
msgstr "Nessun token salvato."

msgid "Shortcode usage"
msgstr "Utilizzo shortcode"

msgid "Platform"
msgstr "Piattaforma"

msgid "Shortcode example"
msgstr "Esempio shortcode"

msgid "Works with any self-hosted Forgejo or Gitea instance."
msgstr "Funziona con qualsiasi istanza Forgejo o Gitea self-hosted."

# translators: %s: plugin version number
msgid "Plugin version: %s"
msgstr "Versione plugin: %s"

msgid "Missing url attribute in the shortcode."
msgstr "Attributo url mancante nello shortcode."

msgid "Error"
msgstr "Errore"

msgid "Project website"
msgstr "Sito web del progetto"

msgid "Website"
msgstr "Sito Web"

msgid "No website set in the repository"
msgstr "Nessun sito web impostato nel repository"

msgid "No website"
msgstr "Nessun sito"

msgid "Go to repository"
msgstr "Vai al repository"

msgid "Last updated"
msgstr "Ultimo aggiornamento"

msgid "Latest release"
msgstr "Ultima versione rilasciata"

msgid "Invalid repository URL."
msgstr "URL repository non valido."

msgid "Invalid repository URL: missing owner/repo in path."
msgstr "URL repository non valido: owner/repo mancante nel percorso."

# translators: %d: HTTP response status code
msgid "API error: HTTP status %d."
msgstr "Errore API: stato HTTP %d."

msgid "Could not parse the API JSON response."
msgstr "Impossibile analizzare la risposta JSON dell'API."

msgid "N/A"
msgstr "N/D"

msgid "%s star"
msgid_plural "%s stars"
msgstr[0] "%s stella"
msgstr[1] "%s stelle"
